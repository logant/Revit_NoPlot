<UserControl x:Class="LINECommon.Windows.Controls.ColorNode"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:LINECommon.Windows.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="20" d:DesignWidth="20">
    <UserControl.Resources>
        <ResourceDictionary Source="../Styles/Brushes.xaml"/>
    </UserControl.Resources>
    <Grid>
       
        <Ellipse x:Name="BoundaryEllipse" Stroke="{DynamicResource ForegroundPrimaryBrush}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="1" StrokeThickness="2"/>
        <Ellipse x:Name="InnerEllipse" Stroke="{DynamicResource BackgroundPrimaryBrush}" StrokeThickness="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="3" Fill="Blue"/>
    </Grid>
</UserControl>
