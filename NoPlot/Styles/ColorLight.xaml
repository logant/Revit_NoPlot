<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ******************** -->
    <!-- **  LIGHT COLORS  ** -->
    <!-- ******************** -->

    <!-- Background -->
    <Color x:Key="BackgroundPrimaryColor">#FFFFFFFF</Color>
    <Color x:Key="BackgroundSecondaryColor">#FFF9F9F9</Color>
    <Color x:Key="BackgroundTertiaryColor">#FFA9A9A9</Color>

    <!-- Foreground -->
    <Color x:Key="ForegroundPrimaryColor">#FF000000</Color>
    <Color x:Key="ForegroundSecondaryColor">#FF707070</Color>

    <Color x:Key="ControlBorderColor">#FF313131</Color>
    <Color x:Key="ControlBackgroundColor">#FFB9B9B9</Color>


    <Color x:Key="HighlightBackground">#FF5C9FF1</Color>
    <Color x:Key="HighlightButton">#FFF0F0F0</Color>

    <Color x:Key="BorderColor">#FF0E3535</Color>

    <Color x:Key="TestColor">#FFFF00FF</Color> 
    <Color x:Key="TestColor2">#FF00FFFF</Color>
   

    <!-- ICONS -->
    <BitmapImage x:Key="IconSource" UriSource="pack://application:,,,/NoPlot;component/resources/line.ico"/>
    <BitmapImage x:Key="IconImgSrc" UriSource="pack://application:,,,/NoPlot;component/resources/line_016b.png"/>

</ResourceDictionary>